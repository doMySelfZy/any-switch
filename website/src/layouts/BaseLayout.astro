---
import "../assets/app.css";
import DocsSidebar from "../components/DocsSidebar.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import Seo from "../components/Seo.astro";
import UiIcon from "../components/UiIcon.astro";
import { t } from "../i18n/ui";
import type { CollectionEntry } from "astro:content";
import {
  GITHUB_REPO_URL,
  LOCALE_STORAGE_KEY,
  THEME_STORAGE_KEY,
  htmlLang,
  localePath,
  type Locale,
} from "../lib/site";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  slug?: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  docs?: CollectionEntry<"docs">[];
  currentDocSlug?: string;
}

const {
  locale,
  title,
  description,
  slug = "",
  type = "website",
  jsonLd,
  docs,
  currentDocSlug,
} = Astro.props;

const nav = t(locale, "nav");
const lang = htmlLang(locale);
---

<!doctype html>
<html
  lang={lang}
  data-theme-storage-key={THEME_STORAGE_KEY}
  data-locale-storage-key={LOCALE_STORAGE_KEY}
  data-current-locale={locale}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      locale={locale}
      title={title}
      description={description}
      slug={slug}
      type={type}
      jsonLd={jsonLd}
    />
    <script is:inline>
      (function () {
        try {
          var ua = navigator.userAgent || "";
          if (/bot|crawl|spider|slurp|bingpreview|facebookexternalhit|embedly|linkedinbot|pinterest|redditbot|whatsapp/i.test(ua)) {
            return;
          }
          var key = document.documentElement.getAttribute("data-locale-storage-key") || "anyswitch-locale";
          var current = document.documentElement.getAttribute("data-current-locale") || "zh";
          var stored = localStorage.getItem(key);
          var preferred = stored;
          if (preferred !== "zh" && preferred !== "en") {
            var navLang = ((navigator.languages && navigator.languages[0]) || navigator.language || "").toLowerCase();
            preferred = navLang.indexOf("zh") === 0 ? "zh" : navLang.indexOf("en") === 0 ? "en" : null;
          }
          if (!preferred || preferred === current) return;
          var path = location.pathname || "/";
          var onEn = path === "/en" || path === "/en/" || path.indexOf("/en/") === 0;
          var next;
          if (preferred === "en") {
            if (onEn) return;
            next = path === "/" ? "/en/" : "/en" + path;
          } else {
            if (!onEn) return;
            next = path.replace(/^\/en/, "") || "/";
            if (next.charAt(next.length - 1) !== "/") next += "/";
          }
          if (next && next !== path) location.replace(next);
        } catch (e) {
          /* ignore */
        }
      })();
    </script>
    <script is:inline>
      (function () {
        try {
          var key = document.documentElement.getAttribute("data-theme-storage-key") || "anyswitch-theme";
          var stored = localStorage.getItem(key);
          var pref = stored === "light" || stored === "dark" || stored === "system" ? stored : "system";
          var theme =
            pref === "light" || pref === "dark"
              ? pref
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.setAttribute("data-theme", theme);
          document.documentElement.setAttribute("data-theme-pref", pref);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
          document.documentElement.setAttribute("data-theme-pref", "system");
        }
      })();
    </script>
  </head>
  <body class="bg-base-100 text-base-content">
    <div class="drawer">
      <input id="app-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content flex min-h-screen flex-col">
        <Navbar locale={locale} slug={slug} />
        <div id="content" class="flex min-h-0 flex-1 flex-col">
          <slot />
        </div>
        <Footer locale={locale} />
      </div>
      <div class="drawer-side z-40">
        <label for="app-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
        <div class="min-h-full w-72 bg-base-100 p-4">
          <ul class="menu w-full">
            <li>
              <a href={localePath(locale, "")}>
                <UiIcon name="lucide:house" />
                {t(locale, "docs").breadcrumbHome}
              </a>
            </li>
            <li>
              <a href={localePath(locale, "docs")}>
                <UiIcon name="lucide:book-open" />
                {nav.docs}
              </a>
            </li>
            <li>
              <a href={localePath(locale, "download")}>
                <UiIcon name="lucide:download" />
                {nav.download}
              </a>
            </li>
            <li>
              <a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer">
                <UiIcon name="lucide:github" />
                {nav.github}
              </a>
            </li>
          </ul>
          {
            docs && docs.length > 0 && (
              <div class="mt-4 border-t border-base-300 pt-4">
                <DocsSidebar locale={locale} docs={docs} currentSlug={currentDocSlug} />
              </div>
            )
          }
        </div>
      </div>
    </div>
  </body>
</html>
