---
import { t } from "../i18n/ui";
import { localePath, type Locale } from "../lib/site";
import UiIcon from "./UiIcon.astro";

interface Props {
  locale: Locale;
  slug?: string;
}

const { locale, slug = "" } = Astro.props;
const nav = t(locale, "nav");
const options = [
  { id: "zh" as const, href: localePath("zh", slug), label: nav.langZh, flag: "circle-flags:cn" },
  { id: "en" as const, href: localePath("en", slug), label: nav.langEn, flag: "circle-flags:us" },
];
const current = options.find((item) => item.id === locale) ?? options[0];
---

<div class="dropdown dropdown-end">
  <div tabindex="0" role="button" class="btn btn-ghost gap-2 px-2" aria-label={nav.language} title={nav.language}>
    <span class="inline-flex size-5 overflow-hidden rounded-full">
      <UiIcon name={current.flag} class="size-5" />
    </span>
    <span class="hidden sm:inline">{current.label}</span>
    <UiIcon name="lucide:chevron-down" class="size-4 opacity-60" />
  </div>
  <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-50 mt-2 w-44 border border-base-300 p-2 shadow-lg">
    {
      options.map((item) => (
        <li>
          <a
            href={item.href}
            hreflang={item.id === "en" ? "en" : "zh-CN"}
            lang={item.id === "en" ? "en" : "zh-CN"}
            data-set-locale={item.id}
            class:list={[{ "menu-active": item.id === locale }]}
            aria-current={item.id === locale ? "true" : undefined}
          >
            <span class="inline-flex size-5 overflow-hidden rounded-full">
              <UiIcon name={item.flag} class="size-5" />
            </span>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script is:inline>
  document.querySelectorAll("[data-set-locale]").forEach(function (link) {
    link.addEventListener("click", function () {
      try {
        var key = document.documentElement.getAttribute("data-locale-storage-key") || "anyswitch-locale";
        var value = link.getAttribute("data-set-locale");
        if (value) localStorage.setItem(key, value);
      } catch (e) {
        /* ignore */
      }
    });
  });
</script>
